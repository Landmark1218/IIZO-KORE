{
  "manifest_version": 3,
  "name": "このツイート最高スギィ！",
  "version": "1.4",
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["iizo.wav", "iisune.wav"],
      "matches": ["https://x.com/*", "https://twitter.com/*"]
    }
  ],
  "icons": {
    "128": "icon.png"
  }
}